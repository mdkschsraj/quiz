# Supabase project settings (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# Server-only. Never expose this in the browser or commit it.
SUPABASE_SERVICE_ROLE_KEY=

# Public base URL used inside QR codes (no trailing slash)
NEXT_PUBLIC_SITE_URL=https://your-app.vercel.app

# Protects /api/cron/finalize (Vercel sends it as a Bearer token)
CRON_SECRET=change-me

# Comma-separated emails allowed into /admin. Create each user in
# Supabase Dashboard -> Authentication -> Users -> Add user (set the password there).
ADMIN_EMAILS=you@example.com

# Shown on the quiz result page. Must be an https facebook.com / fb.com / fb.me link;
# If empty it defaults to https://www.facebook.com/schs.rajshahi/ . An invalid value hides the Facebook buttons.
NEXT_PUBLIC_FACEBOOK_URL=https://www.facebook.com/schs.rajshahi/
# Optional name shown on the result ticket (default: College Quiz Challenge)
NEXT_PUBLIC_BRAND_NAME=
